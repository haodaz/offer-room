#!/bin/sh
# OpenAlex lookups (cached, rate-limit aware). No LLM involved. Needs uv (https://docs.astral.sh/uv/).
#   tools/scholar find "Noah A. Smith" "University of Washington"
#   tools/scholar works A5012345678 [since_year]
#   tools/scholar topic "code-switched" "Cornell University" [since]
#   tools/scholar schools "code-switched" [US] [since]
#   tools/scholar alumni A5012345678 [from] [to]
HERE=$(cd "$(dirname "$0")/.." && pwd)
export HIOFFER_CACHE_DIR="$HERE/.cache/openalex"
exec uv run --quiet --no-project --with httpx python "$HERE/tools/scholar.py" "$@"
